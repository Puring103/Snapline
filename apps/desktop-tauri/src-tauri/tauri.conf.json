{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapline",
  "version": "0.1.0",
  "identifier": "app.snapline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": false
  },
  "app": {
    "windows": [
      {
        "title": "Snapline",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Snapline/assets/**",
          "$APPLOCALDATA/Snapline/assets/**"
        ]
      }
    }
  }
}
