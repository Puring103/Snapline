{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snapline",
  "version": "0.1.0",
  "identifier": "app.snapline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Snapline",
        "url": "/?mode=note",
        "width": 340,
        "height": 440,
        "minWidth": 300,
        "minHeight": 260,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data: https: http:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/Snapline/assets/**",
          "$APPLOCALDATA/Snapline/assets/**",
          "$DATA/Snapline/assets/**",
          "$HOME/.local/share/Snapline/assets/**"
        ]
      }
    }
  }
}
